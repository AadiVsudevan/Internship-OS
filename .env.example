# Copy this file to .env for LOCAL testing only.
# In production, these live in GitHub repo Settings -> Secrets and variables -> Actions.

# Notion (required)
NOTION_TOKEN=secret_xxx                  # Notion integration token (notion.so/my-integrations)
NOTION_OPPORTUNITIES_DB_ID=xxx           # ID of the "Opportunities" database
NOTION_QUEUE_PAGE_ID=xxx                 # ID of the page where weekly digest blocks get appended

# Groq (optional but recommended -- free, no card required, console.groq.com)
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.1-8b-instant          # fast + free-tier friendly; swap to llama-3.3-70b-versatile if you want better judgment and have quota

# Behavior flags
USE_LLM_CLASSIFICATION=true              # set false to run on the rule-based scorer only (zero external API calls)
MAX_NEW_PER_RUN=40                       # safety cap so a bad scrape day can't flood Notion or blow the Groq RPM budget
WEEKLY_QUEUE_TARGET_HOURS=3              # how many hours of applying you want the Monday queue to fill
